+
+static SamplePosition EventPitchIncrement(SamplePosition base, double semitones)
+{
+	if(semitones == 0) return base;
+	return SamplePosition(std::max<int64>(1, mpt::saturate_round<int64>(base.GetRaw() * std::pow(2.0, semitones / 12.0))));
+}
+
+bool CSoundFile::SetEventGain(uint64 identity, double gain)
+{
+	if(!identity || !std::isfinite(gain) || gain < 0 || gain > 1 || GetType() != MOD_TYPE_IT) return false;
+	for(auto &chn : m_PlayState.Chn)
+	{
+		if(chn.vtNoteIdentity != identity || !chn.nLength || !chn.nFadeOutVol) continue;
+		if(chn.dwFlags[CHN_ADLIB] || chn.HasMIDIOutput()) return false;
+		chn.vtGain = gain;
+		return true;
+	}
+	return false;
+}
+
+bool CSoundFile::SetEventPitch(uint64 identity, double semitones)
+{
+	if(!identity || !std::isfinite(semitones) || semitones < -12 || semitones > 12 || GetType() != MOD_TYPE_IT) return false;
+	for(auto &chn : m_PlayState.Chn)
+	{
+		if(chn.vtNoteIdentity != identity || !chn.nLength || !chn.nFadeOutVol) continue;
+		if(chn.dwFlags[CHN_ADLIB] || chn.HasMIDIOutput()) return false;
+		if(chn.vtPitchOffset == semitones) return true;
+		chn.vtPitchOffset = semitones;
+		// A tick not yet mixed will calculate its normal tracker increment once.
+		// Mid-tick, touch only pitch/resampling: do not re-run envelopes or ramps.
+		if(m_PlayState.m_nBufferCount && !chn.vtPitchBaseIncrement.IsZero())
+		{
+			const bool reverse = chn.increment.IsNegative();
+			chn.increment = EventPitchIncrement(chn.vtPitchBaseIncrement, semitones);
+			chn.resamplingMode = chn.vtPitchBaseResampling;
+			if(chn.increment.IsUnity() && !(chn.dwFlags[CHN_VIBRATO] || chn.nAutoVibDepth || chn.resamplingMode == SRCMODE_AMIGA))
+				chn.resamplingMode = SRCMODE_NEAREST;
+			if(reverse) chn.increment.Negate();
+		}
+		return true;
+	}
+	return false;
+}
 
