+	if(GetNumInstruments() && m_playBehaviour[kITInstrWithNoteOffOldEffects]
+		&& instr && !ModCommand::IsNote(note))
+	{
+		if((bPorta && m_SongFlags[SONG_ITCOMPATGXX])
+			|| (!bPorta && m_SongFlags[SONG_ITOLDEFFECTS]))
