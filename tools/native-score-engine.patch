+std::unique_ptr<CSoundFile::VtCheckpoint> CSoundFile::CaptureEventCheckpoint() const
+{
+	// This is a reusable checkpoint for immutable, linear PCM IT score backing.
+	// Plugin/OPL/script state and mutable sample formats need their own save APIs.
+	if(GetType() != MOD_TYPE_IT || !m_vtExactClassicClock || m_nRepeatCount != 0
+		|| m_MixerSettings.DSPMask || m_MixerSettings.NumInputChannels || m_opl
+		|| !m_globalScript.empty() || m_PlayState.m_midiMacroEvaluationResults) return {};
+#ifndef NO_PLUGINS
+	if(m_loadedPlugins) return {};
+#endif
+	for(INSTRUMENTINDEX i = 1; i <= GetNumInstruments(); ++i)
+		if(Instruments[i] && (Instruments[i]->synth.HasScripts() || Instruments[i]->nMidiChannel || Instruments[i]->nMixPlug)) return {};
+	for(SAMPLEINDEX i = 1; i <= GetNumSamples(); ++i)
+		if(Samples[i].uFlags[CHN_ADLIB]) return {};
+	for(const auto &pattern : Patterns)
+		for(const auto &c : pattern)
+			if(ModCommand::IsPcNote(c.note)
+				|| (c.volcmd != VOLCMD_NONE && c.volcmd != VOLCMD_VOLUME)
+				|| (c.command != CMD_NONE && c.command != CMD_PANNING8 && c.command != CMD_CHANNELVOLUME
+					&& c.command != CMD_VOLUMESLIDE && c.command != CMD_GLOBALVOLUME && c.command != CMD_TEMPO)
+				|| (c.command == CMD_TEMPO && c.param < 0x20)
+				|| (c.command == CMD_NONE && c.param)
+				|| (c.command == CMD_CHANNELVOLUME && c.param > 64)
+				|| (c.command == CMD_GLOBALVOLUME && c.param > 128)) return {};
+	return std::make_unique<VtCheckpoint>(*this);
+}
+
+bool CSoundFile::RefreshEventCheckpoint(VtCheckpoint &checkpoint) const
+{
+	// The caller has validated this immutable configuration at its mutation epoch.
+	// Reuse the existing storage; the admitted domain has no scripts or MIDI macros.
+	if(!checkpoint.visited.RestoreLinearRowsFrom(m_visitedRows)) return false;
+	checkpoint.play = m_PlayState;
+	checkpoint.random = m_PRNG;
+	checkpoint.offsets = {m_dryLOfsVol, m_dryROfsVol, m_surroundLOfsVol, m_surroundROfsVol};
+	checkpoint.mixChannels = m_nMixChannels; checkpoint.mixStat = IsFirstTick() ? 0 : m_nMixStat;
+	checkpoint.timing = m_TimingInfo;
+	checkpoint.tickPrepared = m_vtTickPrepared; checkpoint.tailActive = m_vtTailActive;
+	checkpoint.scoreHeads = m_vtScoreHeads; checkpoint.lastHeadKey = m_vtLastHeadKey;
+#ifndef NO_REVERB
+	checkpoint.reverb = m_Reverb;
+	checkpoint.reverbLeft = m_RvbLOfsVol; checkpoint.reverbRight = m_RvbROfsVol;
+#endif
+	return true;
+}
+
+bool CSoundFile::RestoreEventCheckpoint(const VtCheckpoint &checkpoint)
+{
+	if(!m_visitedRows.RestoreLinearRowsFrom(checkpoint.visited)) return false;
+	m_PlayState = checkpoint.play;
+	m_PRNG = checkpoint.random;
+	m_dryLOfsVol = checkpoint.offsets[0]; m_dryROfsVol = checkpoint.offsets[1];
+	m_surroundLOfsVol = checkpoint.offsets[2]; m_surroundROfsVol = checkpoint.offsets[3];
+	m_nMixChannels = checkpoint.mixChannels; m_nMixStat = checkpoint.mixStat;
+	m_TimingInfo = checkpoint.timing;
+	m_vtTickPrepared = checkpoint.tickPrepared; m_vtTailActive = checkpoint.tailActive;
+	m_vtScoreHeads = checkpoint.scoreHeads; m_vtLastHeadKey = checkpoint.lastHeadKey;
+#ifndef NO_REVERB
+	m_Reverb = checkpoint.reverb;
+	m_RvbLOfsVol = checkpoint.reverbLeft; m_RvbROfsVol = checkpoint.reverbRight;
+#endif
+	// Mix buffers are scratch: Read fills them anew; Reverb::Process clears its
+	// pending-send flag before any public read returns. Resampler tables are immutable.
+	return true;
+}
