+bool CSoundFile::IgnoreNoteMap(CHANNELINDEX nChn, uint32 instr)
+{
+	auto &chn = m_PlayState.Chn[nChn];
+	if(m_playBehaviour[kITEmptyNoteMapSlotIgnoreCell] && instr > 0 && instr <= GetNumInstruments()
+	   && Instruments[instr] != nullptr && !Instruments[instr]->HasValidMIDIChannel())
+	{
+		auto note = (chn.rowCommand.note != NOTE_NONE) ? chn.rowCommand.note : chn.nNewNote;
+		if(ModCommand::IsNote(note) && Instruments[instr]->Keyboard[note - NOTE_MIN] == 0)
+		{
+			chn.nNewNote = chn.nLastNote = note;
+			chn.nNewIns = static_cast<ModCommand::INSTR>(instr);
+			chn.rowCommand.Clear();
+			return true;
+		}
+	}
+	return false;
+}
+
+
+int CSoundFile::CheckEventGroupMaps(CHANNELINDEX parent, uint32 instr)
+{
+	auto &group = m_vtGroups[parent];
+	if(group.count < 2) return 1;
+	auto &chn = m_PlayState.Chn[parent];
+	const auto saved = chn;
+	int ignored = 0;
+	for(uint8 i = 0; i < group.count; ++i)
+	{
+		chn = saved;
+		chn.rowCommand.note = group.notes[i];
+		if(IgnoreNoteMap(parent, instr)) ++ignored;
+		else if(!instr && chn.pModInstrument
+			&& m_playBehaviour[kITEmptyNoteMapSlot]
+			&& chn.pModInstrument->Keyboard[group.notes[i] - NOTE_MIN] == 0)
+		{
+			// The ordinary inherited-empty path does not report an ignored cell.
+			// Refuse rather than duplicate its still-playing old sample as a layer.
+			chn = saved;
+			return m_vtGroupError = -3;
+		}
+	}
+	chn = saved;
+	if(ignored && ignored != group.count) return m_vtGroupError = -2;
+	return ignored ? 0 : 1;
+}
+
+bool CSoundFile::HasHeldScoreVoice(CHANNELINDEX parent) const
+{
+	for(CHANNELINDEX i = 0; i < m_PlayState.Chn.size(); ++i)
+	{
+		const auto &chn = m_PlayState.Chn[i];
+		if(chn.IsHeldScoreVoice() && (parent == CHANNELINDEX_INVALID || i == parent || chn.nMasterChn == parent + 1))
+			return true;
+	}
+	return false;
+}
+
+void CSoundFile::ConsumeEventGroupNNA(CHANNELINDEX parent)
+{
+	if(parent >= GetNumChannels() || !m_PlayState.Chn[parent].vtGroupPendingNNA) return;
+	const auto context = m_PlayState.Chn[parent].vtContextKey;
+	m_PlayState.Chn[parent].vtGroupPendingNNA = false;
+	for(CHANNELINDEX i = GetNumChannels(); i < m_PlayState.Chn.size(); ++i)
+	{
+		auto &chn = m_PlayState.Chn[i];
+		if(!chn.vtGroupPendingNNA || chn.nMasterChn != parent + 1) continue;
+		if(chn.vtContextKey != context) continue;
+		chn.vtGroupPendingNNA = false;
+		if(chn.IsHeldScoreVoice() && !context) continue;
+		if(context) chn.vtContextPrimary = false;
+		if(!chn.nLength) continue;
+		if(chn.nFadeOutVol) switch(chn.nNNA)
+		{
+		case NewNoteAction::NoteOff: KeyOff(chn); break;
+		case NewNoteAction::NoteCut: chn.nFadeOutVol = 0; chn.dwFlags.set(CHN_NOTEFADE); break;
+		case NewNoteAction::NoteFade: chn.dwFlags.set(CHN_NOTEFADE); break;
+		case NewNoteAction::Continue: break;
+		}
+		if(!chn.nVolume) { chn.nFadeOutVol = 0; chn.dwFlags.set(CHN_NOTEFADE | CHN_FASTVOLRAMP); }
+		if(!m_vtTickPrepared && m_PlayState.m_nBufferCount && !chn.nFadeOutVol)
+		{
+			chn.nRealVolume = chn.nCalcVolume = 0;
+			chn.newLeftVol = chn.newRightVol = 0;
+			chn.nRampLength = 0;
+			chn.dwFlags.set(CHN_VOLUMERAMP);
+			ProcessRamping(chn);
+		}
+	}
+}
+
+void CSoundFile::ApplyEventGroupEffects(CHANNELINDEX parent, bool volume, ModCommand::VOL vol, ModCommand::COMMAND cmd, uint32 param)
+{
+	if(!m_PlayState.Chn[parent].vtGroupPendingNNA) return;
+	for(CHANNELINDEX i = GetNumChannels(); i < m_PlayState.Chn.size(); ++i)
+	{
+		auto &chn = m_PlayState.Chn[i];
+		if(!chn.vtGroupPendingNNA || chn.nMasterChn != parent + 1 || !chn.nLength || !chn.nFadeOutVol) continue;
+		if(chn.vtContextKey != m_PlayState.Chn[parent].vtContextKey) continue;
+		chn.isFirstTick = m_PlayState.Chn[parent].isFirstTick;
+		if(volume) { chn.nVolume = std::min<uint32>(vol, 64) << 2; chn.dwFlags.set(CHN_FASTVOLRAMP); }
+		switch(cmd)
+		{
+		case CMD_VOLUMESLIDE: VolumeSlide(chn, static_cast<ModCommand::PARAM>(param)); break;
+		case CMD_PANNING8:
+			if(m_PlayState.m_flags[SONG_FIRSTTICK]) Panning(chn, param, Pan8bit);
+			break;
+		case CMD_CHANNELVOLUME:
+			if(m_PlayState.m_flags[SONG_FIRSTTICK] && param <= 64) {
+				chn.nGlobalVol = static_cast<uint8>(param); chn.dwFlags.set(CHN_FASTVOLRAMP);
+			}
+			break;
+		default: break; // V is already global; admitted backing contains no other effect.
+		}
+	}
+}
+
+CHANNELINDEX CSoundFile::TriggerEventGroup(CHANNELINDEX parent, uint32 instr, ModCommand::COMMAND cmd, uint32 param, ModCommand::VOLCMD volcmd, ModCommand::VOL vol)
+{
+	auto &group = m_vtGroups[parent];
+	const auto seed = m_PlayState.Chn[parent];
+	const auto needed = group.count - 1 + (seed.IsSamplePlaying() ? 1 : 0);
+	int free = 0;
+	for(CHANNELINDEX i = GetNumChannels(); i < m_PlayState.Chn.size(); ++i)
+		if(!IsScoreHeadAnchor(i) && !m_PlayState.Chn[i].nLength && !m_PlayState.Chn[i].HasMIDIOutput()) ++free;
+	if(free < needed) { m_vtGroupError = -4; return CHANNELINDEX_INVALID; }
+	// Complete duplicate checks before creating any sibling, in source order.
+	for(uint8 i = 0; i < group.count; ++i)
+		CheckNNA(parent, instr, group.notes[i], false, true);
+	const auto displaced = CheckNNA(parent, instr, group.notes[group.count - 1], false, false, true);
+	for(uint8 i = 0; i < group.count; ++i)
+	{
+		const bool primary = i + 1 == group.count;
+		const CHANNELINDEX slot = primary ? parent : GetNNAChannel(CHANNELINDEX_INVALID);
+		if(slot == CHANNELINDEX_INVALID) { m_vtGroupError = -4; return displaced; }
+		auto &chn = m_PlayState.Chn[slot];
+		chn = seed;
+		chn.nLength = 0;
+		chn.position.Set(0);
+		chn.nROfs = chn.nLOfs = 0;
+		chn.nMasterChn = primary ? 0 : parent + 1;
+		chn.vtGroupPendingNNA = true;
+		chn.rowCommand.note = group.notes[i];
+		if(!primary)
+		{
+			chn.leftVol = chn.rightVol = chn.newLeftVol = chn.newRightVol = 0;
+			chn.rampLeftVol = chn.rampRightVol = chn.leftRamp = chn.rightRamp = 0;
+			chn.nRampLength = 0;
+			chn.nCommand = CMD_NONE;
+		}
+		auto layerInstr = instr;
+		bool porta = false;
+		ProcessNoteTransition(slot, layerInstr, porta, false, cmd, param, volcmd, vol, true);
+		group.identities[i] = chn.vtNoteIdentity;
+		if(!primary && !m_vtTickPrepared)
+		{
+			if(m_playBehaviour[kITEnvelopePositionHandling])
+			{
+				if(chn.VolEnv.flags[ENV_ENABLED]) chn.VolEnv.nEnvPosition = std::max(uint32(1), chn.VolEnv.nEnvPosition);
+				if(chn.PanEnv.flags[ENV_ENABLED]) chn.PanEnv.nEnvPosition = std::max(uint32(1), chn.PanEnv.nEnvPosition);
+				if(chn.PitchEnv.flags[ENV_ENABLED]) chn.PitchEnv.nEnvPosition = std::max(uint32(1), chn.PitchEnv.nEnvPosition);
+			}
+			ReadNote(slot);
+		}
+	}
+	return displaced;
+}
+
+CHANNELINDEX CSoundFile::ProcessNoteTransition(CHANNELINDEX nChn, uint32 &instr, bool &bPorta, bool continueNote, ModCommand::COMMAND cmd, uint32 param, ModCommand::VOLCMD volcmd, ModCommand::VOL vol, bool groupLayer)
+{
+	auto &chn = m_PlayState.Chn[nChn];
+	if(!groupLayer && nChn < GetNumChannels() && m_vtGroups[nChn].count > 1 && ModCommand::IsNote(chn.rowCommand.note))
+		return TriggerEventGroup(nChn, instr, cmd, param, volcmd, vol);
+	CHANNELINDEX displaced = CHANNELINDEX_INVALID;
+	ModCommand::NOTE note = chn.rowCommand.note;
+	if(ModCommand::IsNote(note) && chn.IsHeldScoreVoice() && !chn.vtContextKey)
+	{
+		if(!m_vtGroupTransaction || bPorta || continueNote || groupLayer)
+		{
+			m_vtGroupError = -6;
+			return CHANNELINDEX_INVALID;
+		}
+		// Save the old live voice before changing instrument/note memories.
+		// This is neither an instrument NNA nor a fresh synthetic note/tick.
+		displaced = GetNNAChannel(CHANNELINDEX_INVALID);
+		if(displaced == CHANNELINDEX_INVALID) return displaced;
+		auto &saved = m_PlayState.Chn[displaced];
+		saved = chn;
+		saved.nMasterChn = nChn + 1;
+		saved.vtGroupPendingNNA = false;
+		saved.rowCommand.Clear();
+		chn.vtHoldOwned = false;
+		chn.vtNoteIdentity = 0;
+		chn.nLength = 0;
+		chn.position.Set(0);
+		chn.nROfs = chn.nLOfs = 0;
+		chn.rightVol = chn.leftVol = 0;
+	}
+	if(instr)
+	{
+		chn.nNewIns = static_cast<ModCommand::INSTR>(instr);
+		chn.swapSampleIndex = GetSampleIndex(ModCommand::IsNote(note) ? note : chn.nLastNote, instr);
+	}
+
+	if(ModCommand::IsNote(note) && m_playBehaviour[kFT2Transpose])
+	{
+		// Notes that exceed FT2's limit are completely ignored.
+		// Test case: NoteLimit.xm
+		int transpose = chn.nTranspose;
+		if(instr && !bPorta)
+		{
+			// Refresh transpose
+			// Test case: NoteLimit2.xm
+			const SAMPLEINDEX sample = GetSampleIndex(note, instr);
+			if(sample > 0)
+				transpose = GetSample(sample).RelativeTone;
+		}
+
+		const int computedNote = note + transpose;
+		if((computedNote < NOTE_MIN + 11 || computedNote > NOTE_MIN + 130))
+		{
+			note = NOTE_NONE;
+		}
+	} else if((GetType() & (MOD_TYPE_IT | MOD_TYPE_MPT | MOD_TYPE_J2B)) && GetNumInstruments() != 0 && ModCommand::IsNoteOrEmpty(static_cast<ModCommand::NOTE>(note)))
+	{
+		// IT compatibility: Invalid instrument numbers do nothing, but they are remembered for upcoming notes and do not trigger a note in that case.
+		// Test case: InstrumentNumberChange.it
+		INSTRUMENTINDEX instrToCheck = static_cast<INSTRUMENTINDEX>((instr != 0) ? instr : chn.nOldIns);
+		if(instrToCheck != 0 && (instrToCheck > GetNumInstruments() || Instruments[instrToCheck] == nullptr))
+		{
+			note = NOTE_NONE;
+			instr = 0;
+		}
+	}
+
+	// XM: FT2 ignores a note next to a K00 effect, and a fade-out seems to be done when no volume envelope is present (not exactly the Kxx behaviour)
+	if(cmd == CMD_KEYOFF && param == 0 && m_playBehaviour[kFT2KeyOff])
+	{
+		note = NOTE_NONE;
+		instr = 0;
+	}
+
+	bool retrigEnv = note == NOTE_NONE && instr != 0;
+
+	// Apparently, any note number in a pattern causes instruments to recall their original volume settings - no matter if there's a Note Off next to it or whatever.
+	// Test cases: keyoff+instr.xm, delay.xm
+	bool reloadSampleSettings = (m_playBehaviour[kFT2ReloadSampleSettings] && instr != 0);
+	bool keepInstr = (GetType() & (MOD_TYPE_IT | MOD_TYPE_MPT)) || m_playBehaviour[kST3SampleSwap];
+	if(m_playBehaviour[kMODSampleSwap])
+	{
+		// ProTracker Compatibility: If a sample was stopped before, lone instrument numbers can retrigger it
+		// Test cases: PTSwapEmpty.mod, PTInstrVolume.mod, PTStoppedSwap.mod
+		if(!chn.IsSamplePlaying() && instr <= GetNumSamples() && Samples[instr].uFlags[CHN_LOOP])
+			keepInstr = true;
+	}
+
+	// Now it's time for some FT2 crap...
+	if (GetType() & (MOD_TYPE_XM | MOD_TYPE_MT2))
+	{
+		// XM: Key-Off + Sample == Note Cut (BUT: Only if no instr number or volume effect is present!)
+		// Test case: NoteOffVolume.xm
+		if(note == NOTE_KEYOFF
+			&& ((!instr && volcmd != VOLCMD_VOLUME && cmd != CMD_VOLUME) || !m_playBehaviour[kFT2KeyOff])
+			&& (chn.pModInstrument == nullptr || !chn.pModInstrument->VolEnv.dwFlags[ENV_ENABLED]))
+		{
+			chn.dwFlags.set(CHN_FASTVOLRAMP);
+			chn.nVolume = 0;
+			note = NOTE_NONE;
+			instr = 0;
+			retrigEnv = false;
+			// FT2 Compatibility: Start fading the note for notes with no delay. Only relevant when a volume command is encountered after the note-off.
+			// Test case: NoteOffFadeNoEnv.xm
+			if(m_PlayState.m_flags[SONG_FIRSTTICK] && m_playBehaviour[kFT2NoteOffFlags])
+				chn.dwFlags.set(CHN_NOTEFADE);
+		} else if(m_playBehaviour[kFT2RetrigWithNoteDelay] && !m_PlayState.m_flags[SONG_FIRSTTICK])
+		{
+			// FT2 Compatibility: Some special hacks for rogue note delays... (EDx with x > 0)
+			// Apparently anything that is next to a note delay behaves totally unpredictable in FT2. Swedish tracker logic. :)
+
+			retrigEnv = true;
+
+			// Portamento + Note Delay = No Portamento
+			// Test case: porta-delay.xm
+			bPorta = false;
+
+			if(note == NOTE_NONE)
+			{
+				// If there's a note delay but no real note, retrig the last note.
+				// Test case: delay2.xm, delay3.xm
+				note = static_cast<ModCommand::NOTE>(chn.nNote - chn.nTranspose);
+			} else if(note >= NOTE_MIN_SPECIAL)
+			{
+				// Gah! Even Note Off + Note Delay will cause envelopes to *retrigger*! How stupid is that?
+				// ... Well, and that is actually all it does if there's an envelope. No fade out, no nothing. *sigh*
+				// Test case: OffDelay.xm
+				note = NOTE_NONE;
+				keepInstr = false;
+				reloadSampleSettings = true;
+			} else if(instr || !m_playBehaviour[kFT2NoteDelayWithoutInstr])
+			{
+				// Normal note (only if there is an instrument, test case: DelayVolume.xm)
+				keepInstr = true;
+				reloadSampleSettings = true;
+			}
+		}
+	}
+
+	if((retrigEnv && !m_playBehaviour[kFT2ReloadSampleSettings]) || reloadSampleSettings)
+	{
