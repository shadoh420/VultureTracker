+				// Instrument mode
+				if(instr <= GetNumInstruments() && (chn.pModInstrument != Instruments[instr] || triggerAfterSmpEnd))
+					note = chn.nNote;
+			} else
+			{
+				// Sample mode
+				if(instr < MAX_SAMPLES && (chn.pModSample != &Samples[instr] || triggerAfterSmpEnd))
