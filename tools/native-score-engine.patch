+					|| (c.volcmd != OpenMPT::VOLCMD_NONE && notes[i * 4 + 3] >= 0 && c.vol != notes[i * 4 + 3])))
+					|| (cmd != OpenMPT::CMD_NONE && cmd != OpenMPT::CMD_PANNING8 && cmd != OpenMPT::CMD_CHANNELVOLUME
+						&& cmd != OpenMPT::CMD_VOLUMESLIDE && cmd != OpenMPT::CMD_GLOBALVOLUME && cmd != OpenMPT::CMD_TEMPO)
+					|| (cmd == OpenMPT::CMD_TEMPO && c.param < 0x20)
+					|| (cmd == OpenMPT::CMD_CHANNELVOLUME && c.param > 64)
+					|| (cmd == OpenMPT::CMD_GLOBALVOLUME && c.param > 128)) {
+					// Runtime backing conflict: finish the prepared tick's effects, report failure.
+					if(rowLoaded) m_sndFile->ProcessEffects();
+					return false;
+				}
+			}
+		}
+		for(std::int32_t i = 0; i < offCount; ++i) if(offIds[i] > 0) vt_parent_off(offIds[i]);
+		if(!rowLoaded) {
+			for(std::int32_t i = 0; i < noteCount; ++i) {
+				const auto *n = notes + i * 4;
+				identities[i] = vt_parent_note(n[0], n[1], n[2], n[3]);
+				if(identities[i] < 0) return false;
+			}
+			return true;
+		}
+		std::array<std::uint64_t, 64> previous{};
+		for(std::int32_t i = 0; i < noteCount; ++i) {
+			const auto *n = notes + i * 4;
+			auto &chn = m_sndFile->m_PlayState.Chn[n[0]];
+			previous[i] = chn.vtNoteIdentity;
+			chn.rowCommand.note = static_cast<OpenMPT::ModCommand::NOTE>(n[1] + OpenMPT::NOTE_MIN);
+			if(n[2]) chn.rowCommand.instr = static_cast<OpenMPT::ModCommand::INSTR>(n[2]);
+			if(n[3] >= 0) {
+				chn.rowCommand.volcmd = OpenMPT::VOLCMD_VOLUME;
+				chn.rowCommand.vol = static_cast<OpenMPT::ModCommand::VOL>(n[3]);
+			}
+		}
+		if(!m_sndFile->ProcessEffects()) return false;
+		for(std::int32_t i = 0; i < noteCount; ++i) {
+			const auto identity = m_sndFile->m_PlayState.Chn[notes[i * 4]].vtNoteIdentity;
+			identities[i] = identity != previous[i] ? static_cast<std::int64_t>(identity) : 0;
+		}
+		return true;
+	}
+
+	std::int32_t module_ext_impl::vt_parent_groups(std::int32_t samplerate, std::int32_t offCount, const std::int64_t *offIds,
+		std::int32_t groupCount, const std::int32_t *groups, std::int32_t outputCapacity, std::int64_t *identities,
+		const std::int32_t *holdFlags) {
+		if(groupCount)
+			for(const auto &head : m_sndFile->m_vtScoreHeads) if(head.key) return -6;
+		if(!m_mixer_initialized || samplerate != static_cast<std::int32_t>(m_sndFile->m_MixerSettings.gdwMixingFreq)
+			|| m_sndFile->m_MixerSettings.gnChannels != 2 || m_sndFile->m_vtGroupTransaction
+			|| groupCount < 0 || groupCount > 64 || outputCapacity < groupCount * 3
+			|| offCount < 0 || offCount > OpenMPT::MAX_CHANNELS || (offCount && !offIds)
+			|| (groupCount && (!groups || !identities))) return 0;
+		std::array<bool, OpenMPT::MAX_BASECHANNELS> parents{};
+		std::array<std::int32_t, 64 * 4> notes{};
+		std::array<std::int64_t, 64> primaryIds{};
+		std::array<std::int64_t, 64 * 3> result{};
+		for(std::int32_t i = 0; i < offCount; ++i) if(offIds[i] < 0) return 0;
+		for(std::int32_t i = 0; i < groupCount; ++i) {
+			const auto *g = groups + i * 7;
+			if(holdFlags && holdFlags[i] != 0 && holdFlags[i] != 1) return 0;
+			if(g[0] < 0 || g[0] >= get_num_channels() || parents[g[0]]
+				|| g[1] < 0 || g[1] > (get_num_instruments() ? get_num_instruments() : get_num_samples())
+				|| g[2] < -1 || g[2] > 64 || g[3] < 1 || g[3] > 3) return 0;
+			for(int j = 0; j < g[3]; ++j) if(g[4+j] < 0 || g[4+j] > 119) return 0;
+			if((holdFlags && holdFlags[i]) || m_sndFile->HasHeldScoreVoice(static_cast<OpenMPT::CHANNELINDEX>(g[0]))) {
+				if(g[3] != 1 || !g[1] || (get_num_instruments() && !m_sndFile->Instruments[g[1]])) return -6;
+			}
+			parents[g[0]] = true;
+			notes[i*4] = g[0]; notes[i*4+1] = g[3+g[3]]; notes[i*4+2] = g[1]; notes[i*4+3] = g[2];
+		}
+		// Validate/allocate once per configuration epoch, including cached refusal.
+		// Playback, group failures and user checkpoint operations do not change it.
+		if(!m_vtGroupCheckpoint || m_vtGroupCheckpoint->epoch != m_vtMutationEpoch) {
+			m_vtGroupCheckpoint = std::make_unique<vt_checkpoint_state>(*this);
+			m_vtHoldParentsEligible.assign(get_num_channels(), 0);
+			++m_vtGroupCheckpointBuilds;
+		} else if(m_vtGroupCheckpoint->engine
+			&& !m_sndFile->RefreshEventCheckpoint(*m_vtGroupCheckpoint->engine)) {
+			return 0;
+		}
+		// Internal rollback only: never replace the user's checkpoint or remap IDs.
+		auto *snapshot = m_vtGroupCheckpoint->engine.get();
+		if(!snapshot) return 0;
+		for(std::int32_t i = 0; holdFlags && i < groupCount; ++i) {
+			if(!holdFlags[i]) continue;
+			const auto parent = static_cast<OpenMPT::CHANNELINDEX>(groups[i*7]);
+			auto &eligible = m_vtHoldParentsEligible[parent];
+			if(!eligible) {
+				eligible = 1;
+				for(const auto &pattern : m_sndFile->Patterns) {
+					if(!pattern.IsValid()) continue;
+					for(OpenMPT::ROWINDEX row = 0; row < pattern.GetNumRows(); ++row) {
+						const auto &c = *pattern.GetpModCommand(row, parent);
+						if(c.note != OpenMPT::NOTE_NONE || c.instr || c.volcmd != OpenMPT::VOLCMD_NONE
+							|| (c.command != OpenMPT::CMD_NONE && c.command != OpenMPT::CMD_TEMPO && c.command != OpenMPT::CMD_GLOBALVOLUME)) {
+							eligible = -1;
+							break;
+						}
+					}
+					if(eligible < 0) break;
+				}
+			}
+			if(eligible < 0) return -6;
+		}
+		// An empty call primes this configuration without preparing a raw boundary.
+		if(!offCount && !groupCount) return 1;
+		auto finish = [&]() {
+			m_sndFile->m_vtGroups = {};
+			m_sndFile->m_vtGroupTransaction = false;
+		};
+		m_sndFile->m_vtGroupError = 0;
+		m_sndFile->m_vtGroupTransaction = true;
+		for(std::int32_t i = 0; i < groupCount; ++i) {
+			const auto *g = groups + i * 7;
+			auto &plan = m_sndFile->m_vtGroups[g[0]];
+			plan.count = static_cast<std::uint8_t>(g[3]);
+			plan.hold = holdFlags && holdFlags[i] != 0;
+			for(int j = 0; j < g[3]; ++j) plan.notes[j] = static_cast<OpenMPT::ModCommand::NOTE>(g[4+j] + OpenMPT::NOTE_MIN);
+		}
+		try {
+			if(!vt_parent_batch(samplerate, offCount, offIds, groupCount, notes.data(), primaryIds.data())
+				|| m_sndFile->m_vtGroupError) {
+				const int error = m_sndFile->m_vtGroupError ? m_sndFile->m_vtGroupError : -5;
+				m_sndFile->RestoreEventCheckpoint(*snapshot);
+				finish();
+				return error;
+			}
+			for(std::int32_t i = 0; i < groupCount; ++i) {
+				const auto *g = groups + i * 7;
+				if(g[3] == 1) result[i*3] = primaryIds[i];
+				else for(int j = 0; j < g[3]; ++j)
+					result[i*3+j] = static_cast<std::int64_t>(m_sndFile->m_vtGroups[g[0]].identities[j]);
+			}
+			finish();
+			if(groupCount) std::copy_n(result.data(), groupCount*3, identities);
+			return 1;
+		} catch(...) {
+			m_sndFile->RestoreEventCheckpoint(*snapshot);
+			finish();
+			throw;
+		}
+	}
+
+	std::int32_t module_ext_impl::vt_score_contexts(std::int32_t rate, std::int32_t offCount, const std::int64_t *offIds,
+		std::int32_t closeCount, const std::int64_t *closeKeys, std::int32_t attackCount,
+		const std::int64_t *headKeys, const std::int32_t *attacks, std::int32_t capacity, std::int64_t *identities) {
+		if(attackCount && m_sndFile->m_vtTailActive) return -5;
+		if(attackCount < 0 || attackCount > 64 || capacity < attackCount * 3
+			|| closeCount < 0 || closeCount > 64 || offCount < 0 || offCount > 256
+			|| (offCount && !offIds) || (closeCount && !closeKeys)
+			|| (attackCount && (!headKeys || !attacks || !identities))) return 0;
+		for(int i = 0; i < offCount; ++i) if(offIds[i] < 0) return 0;
+		if(vt_parent_groups(rate, 0, nullptr, 0, nullptr, 0, nullptr) != 1) return 0;
+		auto findHead = [&](std::int64_t key) -> OpenMPT::CSoundFile::VtScoreHead * {
+			for(auto &head : m_sndFile->m_vtScoreHeads) if(key > 0 && head.key == static_cast<uint64_t>(key)) return &head;
+			return nullptr;
+		};
+		std::array<int, OpenMPT::MAX_BASECHANNELS> domains{};
+		std::array<std::int32_t, 64 * 4> legacy{};
+		std::array<std::int64_t, 64> legacyIds{};
+		std::array<std::int64_t, 64 * 3> result{};
+		int legacyCount = 0;
+		auto lastKey = m_sndFile->m_vtLastHeadKey;
+		for(int i = 0; i < attackCount; ++i) {
+			const auto *a = attacks + i * 8;
+			if(a[0] < 0 || a[0] >= get_num_channels() || a[1] < 0
+				|| a[1] > (get_num_instruments() ? get_num_instruments() : get_num_samples())
+				|| a[2] < -1 || a[2] > 64 || a[3] < 1 || a[3] > 3 || a[7] < 0 || a[7] > 2) return 0;
+			for(int j = 0; j < a[3]; ++j) if(a[4+j] < 0 || a[4+j] > 119) return 0;
+			if(!a[7]) {
+				if(headKeys[i] || domains[a[0]] || m_sndFile->HasHeldScoreVoice(static_cast<OpenMPT::CHANNELINDEX>(a[0]))) return -6;
+				for(const auto &head : m_sndFile->m_vtScoreHeads) if(head.key && head.parent == a[0]) return -6;
+				domains[a[0]] = 1;
+				legacy[legacyCount*4] = a[0]; legacy[legacyCount*4+1] = a[3+ a[3]];
+				legacy[legacyCount*4+2] = a[1]; legacy[legacyCount*4+3] = a[2]; ++legacyCount;
+				continue;
+			}
+			if(domains[a[0]] == 1 || !a[1]) return -6;
+			domains[a[0]] = 2;
+			for(int j = 0; j < i; ++j) if(headKeys[j] == headKeys[i]) return -7;
+			if(a[7] == 1) {
+				if(headKeys[i] <= 0 || static_cast<uint64_t>(headKeys[i]) <= lastKey) return -7;
+				lastKey = headKeys[i];
+				if(m_sndFile->m_PlayState.Chn[a[0]].vtNoteIdentity) return -6;
+			} else {
+				const auto *head = findHead(headKeys[i]);
+				if(!head || head->parent != a[0] || head->source != a[1]) return -7;
+			}
+			if(get_num_instruments()) {
+				const auto *ins = m_sndFile->Instruments[a[1]];
+				if(!ins || ins->VolEnv.dwFlags[OpenMPT::ENV_CARRY] || ins->PanEnv.dwFlags[OpenMPT::ENV_CARRY]
+					|| ins->PitchEnv.dwFlags[OpenMPT::ENV_CARRY] || ins->nVolSwing || ins->nPanSwing
+					|| ins->nCutSwing || ins->nResSwing) return -6;
+				if(a[7] == 1)
+					for(const auto mapped : ins->Keyboard)
+						if(mapped && mapped <= m_sndFile->GetNumSamples()
+							&& m_sndFile->GetSample(mapped).nVibType == OpenMPT::VIB_RANDOM) return -6;
+				for(int j = 0; j < a[3]; ++j) {
+					const auto sample = ins->Keyboard[a[4+j]];
+					if(!sample || sample > m_sndFile->GetNumSamples()) return -6;
+					if(m_sndFile->GetSample(sample).nVibType == OpenMPT::VIB_RANDOM) return -6;
+				}
+			} else if(m_sndFile->GetSample(static_cast<OpenMPT::SAMPLEINDEX>(a[1])).nVibType == OpenMPT::VIB_RANDOM) return -6;
+			auto &eligible = m_vtHoldParentsEligible[a[0]];
+			if(!eligible) {
+				eligible = 1;
+				for(const auto &pattern : m_sndFile->Patterns) {
+					if(!pattern.IsValid()) continue;
+					for(OpenMPT::ROWINDEX row = 0; row < pattern.GetNumRows(); ++row) {
+						const auto &c = *pattern.GetpModCommand(row, a[0]);
+						if(c.note || c.instr || c.volcmd != OpenMPT::VOLCMD_NONE
+							|| (c.command != OpenMPT::CMD_NONE && c.command != OpenMPT::CMD_TEMPO && c.command != OpenMPT::CMD_GLOBALVOLUME)) {
+							eligible = -1; break;
+						}
+					}
+					if(eligible < 0) break;
+				}
+			}
+			if(eligible < 0) return -6;
+		}
+		for(int i = 0; i < closeCount; ++i) {
+			if(closeKeys[i] <= 0) return -7;
+			for(int j = 0; j < i; ++j) if(closeKeys[j] == closeKeys[i]) return -7;
+			bool opened = false;
+			for(int j = 0; j < attackCount; ++j) if(headKeys[j] == closeKeys[i] && attacks[j*8+7] == 1) opened = true;
+			if(!opened && !findHead(closeKeys[i])) return -7;
+		}
+		if(!attackCount && !offCount && !closeCount) return 1;
+		auto fail = [&](int error) {
+			m_sndFile->RestoreEventCheckpoint(*m_vtGroupCheckpoint->engine);
+			m_sndFile->m_vtGroups = {};
+			m_sndFile->m_vtGroupTransaction = false;
+			return error;
+		};
+		m_sndFile->m_vtGroupError = 0;
+		m_sndFile->m_vtGroupTransaction = true;
+		auto planAttack = [&](const std::int32_t *a) {
+			auto &plan = m_sndFile->m_vtGroups[a[0]];
+			plan.count = static_cast<std::uint8_t>(a[3]);
+			for(int j = 0; j < a[3]; ++j) plan.notes[j] = static_cast<OpenMPT::ModCommand::NOTE>(a[4+j] + OpenMPT::NOTE_MIN);
+		};
+		try {
+			for(int i = 0; i < attackCount; ++i) if(!attacks[i*8+7]) planAttack(attacks+i*8);
+			if(!vt_parent_batch(rate, offCount, offIds, legacyCount, legacy.data(), legacyIds.data())
+				|| m_sndFile->m_vtGroupError) return fail(m_sndFile->m_vtGroupError ? m_sndFile->m_vtGroupError : -5);
+			legacyCount = 0;
+			for(int i = 0; i < attackCount; ++i) {
+				const auto *a = attacks + i*8;
+				if(a[7]) continue;
+				if(a[3] == 1) result[i*3] = legacyIds[legacyCount];
+				else for(int j = 0; j < a[3]; ++j) result[i*3+j] = m_sndFile->m_vtGroups[a[0]].identities[j];
+				++legacyCount;
+			}
+			m_sndFile->m_vtGroups = {};
+			for(int i = 0; i < attackCount; ++i) {
+				const auto *a = attacks + i * 8;
+				if(!a[7]) continue;
+				auto *head = findHead(headKeys[i]);
+				if(a[7] == 1) {
+					for(auto &entry : m_sndFile->m_vtScoreHeads) if(!entry.key) { head = &entry; break; }
+					if(!head) return fail(-4);
+					const auto anchor = m_sndFile->GetNNAChannel(OpenMPT::CHANNELINDEX_INVALID);
+					if(anchor == OpenMPT::CHANNELINDEX_INVALID) return fail(-4);
+					*head = {static_cast<uint64_t>(headKeys[i]), static_cast<OpenMPT::CHANNELINDEX>(a[0]), anchor,
+						static_cast<OpenMPT::INSTRUMENTINDEX>(a[1])};
+					auto &chn = m_sndFile->m_PlayState.Chn[anchor];
+					chn = m_sndFile->m_PlayState.Chn[a[0]];
+					chn.vtContextKey = headKeys[i]; chn.vtContextPrimary = true; chn.nMasterChn = a[0] + 1;
+					m_sndFile->m_vtLastHeadKey = headKeys[i];
+				}
+				const auto parent = head->parent, anchor = head->anchor;
+				// Run the existing parent transition in-place, then restore routing.
+				// No PCM/tick runs between swaps; keep the mixer list in sync.
+				auto swapChannels = [&]() {
+					std::swap(m_sndFile->m_PlayState.Chn[parent], m_sndFile->m_PlayState.Chn[anchor]);
+					for(OpenMPT::CHANNELINDEX j = 0; j < m_sndFile->m_nMixChannels; ++j) {
+						auto &index = m_sndFile->m_PlayState.ChnMix[j];
+						if(index == parent) index = anchor; else if(index == anchor) index = parent;
+					}
+				};
+				swapChannels();
+				m_sndFile->m_PlayState.Chn[parent].nMasterChn = 0;
+				planAttack(a);
+				std::int64_t primaryId = 0;
+				try { primaryId = vt_parent_note(parent, a[3+a[3]], a[1], a[2]); }
+				catch(...) { swapChannels(); throw; }
+				swapChannels();
+				m_sndFile->m_PlayState.Chn[anchor].nMasterChn = parent + 1;
+				if(a[3] == 1) result[i*3] = primaryId;
+				else for(int j = 0; j < a[3]; ++j) result[i*3+j] = m_sndFile->m_vtGroups[parent].identities[j];
+				m_sndFile->m_vtGroups[parent] = {};
+				if(primaryId <= 0 || m_sndFile->m_vtGroupError)
+					return fail(m_sndFile->m_vtGroupError ? m_sndFile->m_vtGroupError : -6);
+			}
+			for(int i = 0; i < closeCount; ++i) *findHead(closeKeys[i]) = {};
+			m_sndFile->m_vtGroupTransaction = false;
+			if(attackCount) std::copy_n(result.data(), attackCount*3, identities);
+			return 1;
+		} catch(...) { fail(0); throw; }
+	}
+
+	bool module_ext_impl::vt_parent_off(std::int64_t identity) {
+		if(identity <= 0 || !m_sndFile->PrepareEventBoundary()) return false;
+		for(std::int32_t channel = 0; channel < OpenMPT::MAX_CHANNELS; ++channel) {
+			auto &chn = m_sndFile->m_PlayState.Chn[channel];
+			if(chn.vtNoteIdentity != static_cast<std::uint64_t>(identity) || !chn.nLength || !chn.nFadeOutVol) continue;
+			if(channel < get_num_channels()) return vt_parent_note(channel, -1, 0, -1) >= 0;
+			// PCM NNA release follows the same special-note transition; no extra modulation tick.
+			const auto saved = chn.rowCommand;
+			chn.rowCommand.Clear(); chn.rowCommand.note = OpenMPT::NOTE_KEYOFF;
+			std::uint32_t instrument = 0; bool porta = false;
+			try { m_sndFile->ProcessNoteTransition(static_cast<OpenMPT::CHANNELINDEX>(channel), instrument, porta, false, OpenMPT::CMD_NONE, 0, OpenMPT::VOLCMD_NONE, 0); }
+			catch(...) { chn.rowCommand = saved; throw; }
+			chn.rowCommand = saved;
+			return true;
+		}
+		return false;
+	}
+
+	std::int64_t module_ext_impl::vt_parent_note(std::int32_t parent, std::int32_t note, std::int32_t instrument, std::int32_t volume) {
+		if(note >= 0 && !m_sndFile->m_vtGroupTransaction)
+			for(const auto &head : m_sndFile->m_vtScoreHeads) if(head.key) return -1;
+		if(note >= 0 && !m_sndFile->m_vtGroupTransaction && m_sndFile->HasHeldScoreVoice()) return -1;
+		if(note >= 0 && m_sndFile->m_vtTailActive) return -1;
+		if(parent < 0 || parent >= get_num_channels() || note < -1 || note > 119 || volume < -1 || volume > 64) return -1;
+		if(instrument < 0 || instrument > (get_num_instruments() ? get_num_instruments() : get_num_samples())) return -1;
+		if(!(m_sndFile->GetType() & (OpenMPT::MOD_TYPE_IT | OpenMPT::MOD_TYPE_MPT))) return -1;
+		if(!m_sndFile->PrepareEventBoundary()) return -1;
+		auto &chn = m_sndFile->m_PlayState.Chn[parent];
+		const auto savedCommand = chn.rowCommand;
+		chn.rowCommand.Clear();
+		chn.rowCommand.note = static_cast<OpenMPT::ModCommand::NOTE>(note < 0 ? OpenMPT::NOTE_KEYOFF : note + OpenMPT::NOTE_MIN);
+		chn.rowCommand.instr = static_cast<OpenMPT::ModCommand::INSTR>(instrument);
+		if(volume >= 0) {
+			chn.rowCommand.volcmd = OpenMPT::VOLCMD_VOLUME;
+			chn.rowCommand.vol = static_cast<OpenMPT::ModCommand::VOL>(volume);
+		}
+		try {
+			if(note >= 0 && m_sndFile->CheckEventGroupMaps(static_cast<OpenMPT::CHANNELINDEX>(parent), instrument) < 0) {
+				chn.rowCommand = savedCommand;
+				return -1;
+			}
+			if(m_sndFile->IgnoreNoteMap(static_cast<OpenMPT::CHANNELINDEX>(parent), instrument)) {
+				chn.rowCommand = savedCommand;
+				return 0; // Normal ignored empty-map command; no voice identity to release.
+			}
+			std::uint32_t instr = instrument;
+			bool porta = false;
+			const auto displaced = m_sndFile->ProcessNoteTransition(static_cast<OpenMPT::CHANNELINDEX>(parent), instr, porta, false,
+				OpenMPT::CMD_NONE, 0, chn.rowCommand.volcmd, chn.rowCommand.vol);
+			if(instrument) chn.nOldIns = static_cast<OpenMPT::ModCommand::INSTR>(instrument);
+			// A prepared tick will calculate every voice once after all same-frame events.
+			// An extra refresh here consumes the note-start ramp/filter state prematurely.
+			if(note >= 0 && !m_sndFile->m_vtTickPrepared) {
+				if(m_sndFile->m_playBehaviour[OpenMPT::kITEnvelopePositionHandling]) {
+					// IT counters are one-based: initialize musical position zero, without a tick.
+					if(chn.VolEnv.flags[OpenMPT::ENV_ENABLED]) chn.VolEnv.nEnvPosition = std::max(std::uint32_t(1), chn.VolEnv.nEnvPosition);
+					if(chn.PanEnv.flags[OpenMPT::ENV_ENABLED]) chn.PanEnv.nEnvPosition = std::max(std::uint32_t(1), chn.PanEnv.nEnvPosition);
+					if(chn.PitchEnv.flags[OpenMPT::ENV_ENABLED]) chn.PitchEnv.nEnvPosition = std::max(std::uint32_t(1), chn.PitchEnv.nEnvPosition);
+				}
+				m_sndFile->ReadNote(static_cast<OpenMPT::CHANNELINDEX>(parent));
+				if(displaced != OpenMPT::CHANNELINDEX_INVALID) {
+					// NNA copied already-calculated mixer state. Preserve its current pitch,
+					// filter and panning rather than recalculating/advancing modulation.
+					auto &background = m_sndFile->m_PlayState.Chn[displaced];
