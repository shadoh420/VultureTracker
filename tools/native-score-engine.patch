+		if ((bPorta) && (GetType() & (MOD_TYPE_XM|MOD_TYPE_MT2)) && (instr))
+		{
+			chn.dwFlags.set(CHN_FASTVOLRAMP);
+			chn.ResetEnvelopes();
+			chn.nAutoVibDepth = 0;
+			chn.nAutoVibPos = 0;
+		}
+		if(chn.dwFlags[CHN_ADLIB] && m_opl
+			&& ((note == NOTE_NOTECUT || note == NOTE_KEYOFF) || (note == NOTE_FADE && !m_playBehaviour[kOPLFlexibleNoteOff])))
